# 配置文件模板：复制为 .env 后填入真实值
# 应用
APP_NAME=晨光Agent平台
APP_ENV=development
APP_DEBUG=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=chenguang_db

# Redis（本地 docker-compose 里的密码是 123456）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_password
REDIS_DB=0

# JWT 签名密钥：生成方式 python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secret_key

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs